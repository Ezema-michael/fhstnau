# Set the actual review subdomain before starting. No trailing slash.
DOMAIN=review.fhstnau.org
APP_URL=https://review.fhstnau.org
# Private Faculty review is the default. Set false only for an authorised public launch.
REVIEW_PRIVATE=true
COOKIE_SECURE=true
# DATA_DIR is supplied by Compose. Accounts are provisioned interactively, not through env passwords.
